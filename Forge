#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
    script_parent="$(cd -P "$(dirname "$script_path")" && pwd)"
    script_target="$(readlink "$script_path")"
    if [[ "$script_target" == /* ]]; then
        script_path="$script_target"
    else
        script_path="$script_parent/$script_target"
    fi
done

script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"

# Load core modules needed for Forge subcommands
for _forge_mod in \
    "$script_dir/lib/core/config.sh" \
    "$script_dir/lib/core/common.sh" \
    "$script_dir/lib/core/state.sh" \
    "$script_dir/lib/core/history.sh" \
    "$script_dir/lib/core/apps.sh" \
    "$script_dir/lib/providers/flatpak.sh" \
    "$script_dir/lib/providers/snap.sh" \
    "$script_dir/lib/providers/native.sh" \
    "$script_dir/lib/core/forge.sh"
do
    [[ -r "$_forge_mod" ]] || { echo "Forge: missing module $_forge_mod" >&2; exit 1; }
    . "$_forge_mod"
done
unset _forge_mod

case "${1:-version}" in
    env)
        forge_env
        ;;
    resolve)
        shift
        # Allow optional provider flag before the package name
        _forge_prov="auto"
        if [[ $# -gt 0 ]] && _p="$(provider_from_flag "$1" 2>/dev/null)"; then
            _forge_prov="$_p"
            shift
        fi
        forge_resolve "${1:-}" "$_forge_prov"
        ;;
    check)
        shift
        forge_check "${1:-}"
        ;;
    plan)
        shift
        _forge_prov="auto"
        if [[ $# -gt 0 ]] && _p="$(provider_from_flag "$1" 2>/dev/null)"; then
            _forge_prov="$_p"
            shift
        fi
        forge_plan "$_forge_prov" "$@"
        ;;
    version|--version|-v)
        exec "$script_dir/version"
        ;;
    help|-h|--help)
        forge_usage
        ;;
    "")
        forge_usage
        ;;
    *)
        # Pass-through to tinypm for all standard package commands
        exec "$script_dir/tinypm" "$@"
        ;;
esac
