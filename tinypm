#!/usr/bin/env bash
# shellcheck disable=SC2034,SC2154
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
    script_parent="$(cd -P "$(dirname "$script_path")" && pwd)"
    script_target="$(readlink "$script_path")"
    if [[ "$script_target" == /* ]]; then
        script_path="$script_target"
    else
        script_path="$script_parent/$script_target"
    fi
done

script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
prog_name="${TINYPM_ENTRYPOINT:-$(basename "$0")}"

for module in \
    "$script_dir/lib/core/config.sh" \
    "$script_dir/lib/core/common.sh" \
    "$script_dir/lib/core/state.sh" \
    "$script_dir/lib/core/history.sh" \
    "$script_dir/lib/core/ui.sh" \
    "$script_dir/lib/core/apps.sh" \
    "$script_dir/lib/providers/flatpak.sh" \
    "$script_dir/lib/providers/snap.sh" \
    "$script_dir/lib/providers/apt.sh" \
    "$script_dir/lib/providers/repo.sh" \
    "$script_dir/lib/providers/de.sh" \
    "$script_dir/lib/providers/anix.sh" \
    "$script_dir/lib/providers/native.sh" \
    "$script_dir/lib/core/forge.sh" \
    "$script_dir/lib/core/actions.sh" \
    "$script_dir/lib/core/doctor.sh" \
    "$script_dir/lib/core/args.sh"
do
    [[ -r "$module" ]] || {
        echo "Forge: missing module $module" >&2
        exit 1
    }
    . "$module"
done

init_cli_context "$@"

case "$action" in
    install)
        [[ "${#packages[@]}" -gt 0 ]] || die "install requires at least one package name"

        if [[ "${dry_run:-0}" -eq 1 ]]; then
            forge_plan "$provider" "${packages[@]}"
        else
            _total="${#packages[@]}" _i=0 _failed=0
            if [[ "$_total" -gt 1 ]]; then
                printf 'Grabbing %d packages: %s\n' "$_total" "$(IFS=', '; echo "${packages[*]}")"
            fi
            for pkg in "${packages[@]}"; do
                _i=$((_i + 1))
                [[ "$_total" -gt 1 ]] && printf '[%d/%d] ' "$_i" "$_total"
                install_pkg "$pkg" "$provider" || {
                    printf 'Install failed: %s\n' "$pkg" >&2
                    printf '  Suggestion: tinypm search %s\n' "$pkg" >&2
                    _failed=$((_failed + 1))
                }
            done
            if [[ "$_total" -gt 1 ]]; then
                _ok=$((_total - _failed))
                printf 'Done: %d installed' "$_ok"
                [[ "$_failed" -gt 0 ]] && printf ', %d failed' "$_failed"
                printf '.\n'
                [[ "$_failed" -gt 0 ]] && exit 1
            fi
        fi
        ;;
    search)
        [[ -n "$package" ]] || die "search requires a query"
        search_pkg "$package" "$provider"
        ;;
    info)
        [[ -n "$package" ]] || die "info requires a package name"
        info_pkg "$package"
        ;;
    remove|uninstall)
        [[ "${#packages[@]}" -gt 0 ]] || die "remove requires at least one package name"
        _total="${#packages[@]}" _i=0
        [[ "$_total" -gt 1 ]] && printf 'Removing %d packages: %s\n' "$_total" "$(IFS=', '; echo "${packages[*]}")"
        for pkg in "${packages[@]}"; do
            _i=$((_i + 1))
            [[ "$_total" -gt 1 ]] && printf '[%d/%d] ' "$_i" "$_total"
            remove_pkg "$pkg" "$provider"
        done
        [[ "$_total" -gt 1 ]] && printf 'Done: %d removed.\n' "$_total"
        ;;
    list)
        list_pkgs "$provider"
        ;;
    add-repo)
        [[ -n "$package" ]] || die "add-repo requires a repository spec"
        add_repo "$package" "${repo_name:-}" "$provider"
        ;;
    de)
        [[ -n "$package" ]] || die "de requires a desktop environment name"
        install_de "$package" "$provider"
        ;;
    managed)
        managed_pkgs
        ;;
    apps)
        installed_apps
        ;;
    discover)
        discover_apps "${package:-}"
        ;;
    run|start)
        [[ -n "$package" ]] || die "run requires an app id or snap/flatpak target"
        run_pkg "$package" "$provider"
        ;;
    update|upgrade)
        update_pkgs "$provider"
        ;;
    check)
        [[ -n "$package" ]] || die "check requires a package name"
        forge_check "$package"
        ;;
    pin)
        [[ -n "$package" ]] || die "pin requires a package name"
        pin_pkg "$package" "$provider"
        ;;
    unpin)
        [[ -n "$package" ]] || die "unpin requires a package name"
        unpin_pkg "$package"
        ;;
    pinned)
        pinned_pkgs
        ;;
    bundle)
        [[ -n "$package" ]] || die "bundle requires a category name or 'list'"
        if [[ "$package" == "list" ]]; then
            bundle_list
        else
            bundle_install "$package" "$provider"
        fi
        ;;
    sync)
        if [[ "${sync_generate:-0}" -eq 1 ]]; then
            sync_generate_manifest "${sync_output:-}"
        else
            sync_install_manifest "${package:-}"
        fi
        ;;
    history)
        show_history "${history_limit:-50}"
        ;;
    doctor)
        doctor
        ;;
    selftest)
        selftest
        ;;
    export-state)
        state_export "${package:-}"
        ;;
    import-state)
        state_import "$package"
        ;;
    help|"")
        usage
        ;;
    version|-v|--version)
        exec "$version_cmd"
        ;;
    *)
        usage
        exit 1
        ;;
esac
