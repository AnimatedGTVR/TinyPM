#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
    script_parent="$(cd -P "$(dirname "$script_path")" && pwd)"
    script_target="$(readlink "$script_path")"
    if [[ "$script_target" == /* ]]; then
        script_path="$script_target"
    else
        script_path="$script_parent/$script_target"
    fi
done

script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
. "$script_dir/lib/core/config.sh"
. "$script_dir/lib/core/common.sh"
. "$script_dir/lib/core/state.sh"
. "$script_dir/lib/core/apps.sh"

flavor_key="$(tinypm_active_flavor)"
logo_file="$(tinypm_logo_file)"

flatpak_status="missing"
snap_status="missing"
native_status="missing"
os_name="$(backend_os_name)"
kernel_name="$(backend_run uname -r 2>/dev/null || echo unknown)"
host_name="$(backend_run hostname 2>/dev/null || echo unknown)"
# shellcheck disable=SC2016
desktop_name="$(backend_run sh -lc 'printf "%s" "${XDG_CURRENT_DESKTOP:-unknown}"' 2>/dev/null || echo unknown)"
# shellcheck disable=SC2016
session_name="$(backend_run sh -lc 'printf "%s" "${XDG_SESSION_TYPE:-unknown}"' 2>/dev/null || echo unknown)"
uptime_text="$(backend_run sh -lc 'uptime -p 2>/dev/null || printf "unknown"' 2>/dev/null || echo unknown)"
arch_name="$(backend_run uname -m 2>/dev/null || uname -m)"
command_count="$(find "$script_dir" -maxdepth 1 \( -type f -o -type l \) | wc -l | tr -d ' ')"
tracked_count="$(tracked_package_count 2>/dev/null || echo 0)"
catalog_total="$(catalog_count 2>/dev/null || echo 0)"
app_total="$(installed_app_count 2>/dev/null || echo 0)"
backend_mode="$([[ "$use_host_backend" -eq 1 ]] && echo host || echo local)"
auth_mode="$(backend_auth_mode)"
native_pm="$(detect_native_pm 2>/dev/null || echo none)"

if backend_has_cmd flatpak; then
    flatpak_status="available"
fi

if backend_has_cmd snap; then
    snap_status="available"
fi

if [[ "$native_pm" != "none" ]]; then
    native_status="$(native_pm_label "$native_pm")"
fi

supports_color=0
if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != "dumb" ]]; then
    supports_color=1
fi

if [[ "$supports_color" -eq 1 ]]; then
    c_key=$'\033[1;36m'
    c_label=$'\033[1;97m'
    c_value=$'\033[0;37m'
    c_dim=$'\033[0;90m'
    c_reset=$'\033[0m'
else
    c_key=''
    c_label=''
    c_value=''
    c_dim=''
    c_reset=''
fi

mapfile -t logo_lines < "$logo_file"
while (( ${#logo_lines[@]} > 0 )) && [[ -z "${logo_lines[0]//[[:space:]]/}" ]]; do
    logo_lines=("${logo_lines[@]:1}")
done
while (( ${#logo_lines[@]} > 0 )) && [[ -z "${logo_lines[-1]//[[:space:]]/}" ]]; do
    unset 'logo_lines[-1]'
done
logo_width=0
for line in "${logo_lines[@]}"; do
    line_length=${#line}
    if (( line_length > logo_width )); then
        logo_width=$line_length
    fi
done

separator="${c_dim}$(printf '%.34s' '----------------------------------')${c_reset}"
info_lines=(
    "${c_label}$(tinypm_version_label)${c_reset}"
    "$separator"
    "${c_key}system${c_reset}    ${c_value}${tinypm_system_name}${c_reset}"
    "${c_key}engine${c_reset}    ${c_value}${tinypm_engine_name}${c_reset}"
    "${c_key}tagline${c_reset}   ${c_value}${tinypm_tagline:-none}${c_reset}"
    "${c_key}host${c_reset}      ${c_value}${host_name}${c_reset}"
    "${c_key}os${c_reset}        ${c_value}${os_name}${c_reset}"
    "${c_key}kernel${c_reset}    ${c_value}${kernel_name}${c_reset}"
    "${c_key}arch${c_reset}      ${c_value}${arch_name}${c_reset}"
    "${c_key}desktop${c_reset}   ${c_value}${desktop_name}${c_reset}"
    "${c_key}session${c_reset}   ${c_value}${session_name}${c_reset}"
    "${c_key}uptime${c_reset}    ${c_value}${uptime_text}${c_reset}"
    "${c_key}backend${c_reset}   ${c_value}${backend_mode}${c_reset}"
    "${c_key}auth${c_reset}      ${c_value}${auth_mode}${c_reset}"
    "${c_key}native${c_reset}    ${c_value}${native_pm}${c_reset}"
    "${c_key}backends${c_reset}  ${c_value}native=${native_status} flatpak=${flatpak_status} snap=${snap_status}${c_reset}"
    "${c_key}commands${c_reset}  ${c_value}${command_count}${c_reset}"
    "${c_key}apps${c_reset}      ${c_value}${app_total}${c_reset}"
    "${c_key}tracked${c_reset}   ${c_value}${tracked_count}${c_reset}"
    "${c_key}catalog${c_reset}   ${c_value}${catalog_total}${c_reset}"
    "${c_key}flavor${c_reset}    ${c_value}${flavor_key}${c_reset}"
    "${c_key}state db${c_reset}  ${c_value}$(active_state_db)${c_reset}"
    "${c_key}config${c_reset}    ${c_value}${tinypm_config_file}${c_reset}"
    "${c_key}date${c_reset}      ${c_value}$(date)${c_reset}"
)

line_count=${#logo_lines[@]}
if (( ${#info_lines[@]} > line_count )); then
    line_count=${#info_lines[@]}
fi

padding=$((logo_width + 4))
for ((i = 0; i < line_count; i++)); do
    logo_line=""
    info_line=""

    if (( i < ${#logo_lines[@]} )); then
        logo_line="${logo_lines[$i]}"
    fi

    if (( i < ${#info_lines[@]} )); then
        info_line="${info_lines[$i]}"
    fi

    printf '%-*s%s\n' "$padding" "$logo_line" "$info_line"
done
